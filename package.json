{
  "name": "winlog",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "tsx --test scripts/check-boundaries.test.mjs packages/core/src/index.test.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "build": "turbo run build"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.27",
    "eslint": "^10.12.0",
    "turbo": "^2.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
